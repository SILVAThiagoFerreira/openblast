{
  "project": {
    "title": "MONITORAMENTO SISMOGRÁFICO",
    "client_default": "US MINERAÇÃO VALE-VERDE",
    "base_normativa": "ABNT NBR 9653:2018",
    "footer_badge": "DNA  •  ENAEX",
    "client_override": "US MINERAÇÃO VALE-VERDE"
  },
  "paths": {
    "input_dir": "input",
    "output_root": "output",
    "logs_root": "logs"
  },
  "output": {
    "folder_prefix": "monitoramento_sismografico",
    "file_prefix": "ENAEX_NSR",
    "run_folder_template": "{date}_{time}_{folder_prefix}"
  },
  "logging": {
    "level": "INFO",
    "file_template": "{file_prefix}-{date}_{time}.log"
  },
  "artifacts": {
    "report_pdf": "{file_prefix}-{date}.pdf",
    "report_png": "{file_prefix}-{date}.png",
    "whatsapp_note": "{file_prefix}-{date}_nota_whatsapp.txt",
    "data_json": "{file_prefix}-{date}_dados_extraidos.json",
    "manifest_json": "{file_prefix}-{date}_manifest.json",
    "pressure_chart": "{file_prefix}-{date}_pressao_sonora_nbr.png",
    "vibration_chart": "{file_prefix}-{date}_vibracao_nbr_eixos_zero.png"
  },
  "limits": {
    "sound_pressure_db": 134,
    "vibration_status_mm_s": 0.8,
    "vibration_compliance_mode": "nbr9653_curve",
    "nbr9653_curve": [
      [
        0,
        15
      ],
      [
        4,
        15
      ],
      [
        15,
        20
      ],
      [
        40,
        50
      ],
      [
        1000,
        50
      ]
    ]
  },
  "charts": {
    "figure_width": 9,
    "figure_height": 5.0,
    "web_figure_width": 6.5,
    "figure_dpi": 220,
    "title_font_size": 11,
    "axis_label_font_size": 9,
    "tick_font_size": 8,
    "legend_font_size": 8,
    "annotation_font_size": 8,
    "marker_size": 48,
    "vibration_x_min": 0,
    "vibration_y_min": 0,
    "vibration_y_tick_step": 0.1,
    "vibration_use_broken_y": true,
    "vibration_y_focus_max": 1,
    "vibration_x_max_minimum": 60,
    "vibration_y_max_minimum": 60,
    "pressure_x_min": 0,
    "pressure_y_min": 0,
    "pressure_y_max": 160
  },
  "report_layout": {
    "page_margin": 28,
    "chart_column_gap": 14,
    "chart_inner_padding": 6,
    "chart_header_height": 22,
    "chart_to_points_gap": 16,
    "charts_top_limit": 484,
    "footer_height": 30,
    "footer_accent_height": 2,
    "footer_side_padding": 28,
    "header_points_arrow_offset": 12,
    "header_points_arrow_width": 14,
    "header_points_arrow_gap": 8,
    "header_points_arrow_line_width": 1.5,
    "status_badge_width": 112,
    "status_badge_height": 20,
    "status_badge_radius": 6
  },
  "report_text": {
    "executive_title": "Resumo Executivo",
    "scope_title": "Escopo da Campanha",
    "conclusion_title": "Conclusão Técnica",
    "points_title": "Pontos Monitorados",
    "continued_points_title": "Pontos Monitorados - Continuação",
    "pressure_chart_title": "Pressão Sonora x Distância",
    "vibration_chart_title": "PPV x Limite ABNT"
  },
  "processing": {
    "require_single_event_date": true,
    "allow_missing_optional_fields": true,
    "record_order": "gps_distance_ascending"
  },
  "branding": {
    "logo_path": "assets/enaex_logo_horizontal.png",
    "palette": {
      "enaex_gray": "#38424B",
      "enaex_red": "#E20613",
      "white": "#FFFFFF",
      "gray_50": "#F7F8FA",
      "gray_100": "#E8EAEE",
      "gray_200": "#D9DEE7",
      "gray_300": "#E1E5EA",
      "text": "#111827",
      "muted": "#667085",
      "series_transversal": "#E20613",
      "series_longitudinal": "#38424B",
      "series_vertical": "#16A34A",
      "status_conforme": "#67C70A",
      "status_ausente": "#9AA1AC"
    }
  },
  "report": {
    "show_vibration_index": true
  }
}
